# ReturnGuard AI - environment configuration template
# Copy to backend/.env (backend reads backend/.env) and fill in real values.
# NEVER commit real credentials.

# ---------------------------------------------------------------------------
# General
# ---------------------------------------------------------------------------
# development | test | production
APP_ENV=development
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=480
INSPECTION_TOKEN_EXPIRE_MINUTES=30
# Comma-separated allowed browser origins for the frontend dev server
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------------------
# Database (SQLite for local dev; PostgreSQL for production - see README)
# ---------------------------------------------------------------------------
DATABASE_URL=sqlite:///./data/returnguard.db
# Production example:
# DATABASE_URL=postgresql+psycopg://returndata:password@db-host:5432/returndata

# ---------------------------------------------------------------------------
# Image storage
# ---------------------------------------------------------------------------
STORAGE_DIR=../storage/uploads
MAX_UPLOAD_MB=10
ALLOWED_IMAGE_FORMATS=JPEG,PNG,WEBP,BMP

# ---------------------------------------------------------------------------
# QR authorizations
# ---------------------------------------------------------------------------
QR_TOKEN_TTL_HOURS=72

# ---------------------------------------------------------------------------
# OTP
# ---------------------------------------------------------------------------
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ISSUES_PER_HOUR=5

# ---------------------------------------------------------------------------
# Groq + Qwen multimodal inspection (visual reasoning stage)
# GROQ_VISION_MODEL must be a Groq-hosted model that accepts IMAGE inputs.
# Verified image-capable (Oct 2026, https://console.groq.com/docs/vision):
#   qwen/qwen3.8-27b  (Qwen multimodal: image+text, JSON mode; max 3 imgs/request)
# Text-only Qwen models (e.g. qwen/qwen3-32b) MUST NOT be used here.
# Leave GROQ_API_KEY empty to disable the AI stage: the pipeline still runs OCR
# and YOLO and routes decisions to human review instead of fabricating results.
# ---------------------------------------------------------------------------
GROQ_API_KEY=
GROQ_VISION_MODEL=qwen/qwen3.8-27b
GROQ_TIMEOUT_SECONDS=45
GROQ_MAX_RETRIES=2

# Optional: override the condition scale / disposition policy with your
# official challenge resources (JSON file path). The built-in scale is an
# explicitly UNOFFICIAL placeholder — see docs/GAP_ANALYSIS.md.
CONDITION_SCALE_FILE=

# ---------------------------------------------------------------------------
# SMS delivery
# mock  : local development/tests only; refuses to start when APP_ENV=production
# twilio: real delivery; requires the three values below
# ---------------------------------------------------------------------------
SMS_PROVIDER=mock
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ---------------------------------------------------------------------------
# OCR
# auto (rapidocr preferred, then tesseract) | rapidocr | tesseract | none
# ---------------------------------------------------------------------------
OCR_ENGINE=auto
OCR_TIMEOUT_SECONDS=30
# 0-100 scale: OCR output below this mean confidence is flagged LOW_CONFIDENCE
OCR_LOW_CONFIDENCE_THRESHOLD=55

# ---------------------------------------------------------------------------
# YOLO object detection
# YOLO_MODEL_PATH: local path to weights (.pt / .onnx). "yolov8n.pt" is
# auto-downloaded by ultralytics on first use (generic COCO model - see README
# limitations and how to train custom return-inspection weights).
# ---------------------------------------------------------------------------
YOLO_MODEL_PATH=yolov8n.pt
YOLO_CONFIDENCE_THRESHOLD=0.35
# auto | cpu | cuda
YOLO_DEVICE=auto
YOLO_TIMEOUT_SECONDS=60

# ---------------------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------------------
LOGIN_RATE_LIMIT_ATTEMPTS=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
OTP_RATE_LIMIT_ATTEMPTS=10
OTP_RATE_LIMIT_WINDOW_SECONDS=300

# ---------------------------------------------------------------------------
# One-time admin bootstrap (used only when no ADMIN account exists yet).
# Leave empty and use `python -m scripts.create_admin` instead if preferred.
# ---------------------------------------------------------------------------
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_PASSWORD=
